generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  MANAGER
  RECEPTIONIST
  PRACTITIONER
  CASHIER
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  memberships Member[]
  sessions Session[]
  createdAt DateTime @default(now())
}
model Institute {
  id String @id @default(uuid())
  name String
  slug String @unique
  address String @default("")
  color String @default("#E8B4B8")
  createdAt DateTime @default(now())
  members Member[]
  services Service[]
  clients Client[]
  appointments Appointment[]
  employees Employee[]
}
model Member {
  id String @id @default(uuid())
  userId String
  instituteId String
  role Role @default(OWNER)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  sessions Session[]
  employee Employee?
  @@unique([userId, instituteId])
  @@unique([instituteId, id])
}
model Session {
  tokenHash String @id
  userId String
  memberId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model Service {
  id String @id @default(uuid())
  instituteId String
  name String
  description String @default("")
  category String
  price Int
  duration Int
  active Boolean @default(true)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  employees EmployeeService[]
  @@unique([instituteId, id])
  @@index([instituteId, active])
}
model Client {
  id String @id @default(uuid())
  instituteId String
  name String
  phone String
  email String?
  birthDate DateTime? @db.Date
  marketingConsent Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  @@unique([instituteId, id])
  @@index([instituteId, name])
}
model Appointment {
  id String @id @default(uuid())
  instituteId String
  customerName String
  phone String
  serviceName String
  startsAt DateTime
  endsAt DateTime
  employeeId String?
  clientId String?
  serviceId String?
  duration Int
  price Int
  status String @default("PENDING")
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [instituteId, employeeId], references: [instituteId, id], onDelete: NoAction, onUpdate: NoAction)
  client Client? @relation(fields: [instituteId, clientId], references: [instituteId, id], onDelete: NoAction, onUpdate: NoAction)
  service Service? @relation(fields: [instituteId, serviceId], references: [instituteId, id], onDelete: NoAction, onUpdate: NoAction)
  @@index([instituteId, startsAt])
  @@index([instituteId, employeeId, startsAt])
}
model Employee {
  id String @id @default(uuid())
  instituteId String
  memberId String? @unique
  name String
  phone String @default("")
  job String
  active Boolean @default(true)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [instituteId, memberId], references: [instituteId, id], onDelete: NoAction, onUpdate: NoAction)
  schedules EmployeeSchedule[]
  absences EmployeeAbsence[]
  services EmployeeService[]
  appointments Appointment[]
  @@unique([instituteId, memberId])
  @@unique([instituteId, id])
  @@index([instituteId, active])
}
model EmployeeService {
  instituteId String
  employeeId String
  serviceId String
  employee Employee @relation(fields: [instituteId, employeeId], references: [instituteId, id], onDelete: Cascade)
  service Service @relation(fields: [instituteId, serviceId], references: [instituteId, id], onDelete: Cascade)
  @@id([instituteId, employeeId, serviceId])
}
model EmployeeSchedule {
  id String @id @default(uuid())
  instituteId String
  employeeId String
  weekday Int
  startMinute Int
  endMinute Int
  employee Employee @relation(fields: [instituteId, employeeId], references: [instituteId, id], onDelete: Cascade)
  @@unique([instituteId, employeeId, weekday])
}
model EmployeeAbsence {
  id String @id @default(uuid())
  instituteId String
  employeeId String
  startsAt DateTime
  endsAt DateTime
  reason String @default("")
  employee Employee @relation(fields: [instituteId, employeeId], references: [instituteId, id], onDelete: Cascade)
  @@index([instituteId, employeeId, startsAt])
}
